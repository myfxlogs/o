#!/usr/bin/env bash
# sengen —— sensenova 文生图/图生图 CLI(devin 专用工具,不入 O 仓)
# 用: sengen gen  "提示词" [尺寸 auto|WxH] [输出文件]
#     sengen edit "提示词" <参考图文件> [尺寸 auto|WxH] [输出文件]
# key: /home/mluser/.config/sensenova/key 或 SENSENOVA_API_KEY
set -euo pipefail
KEY="${SENSENOVA_API_KEY:-$(cat /home/mluser/.config/sensenova/key 2>/dev/null || true)}"
[ -n "$KEY" ] || { echo "key 缺——写 /home/mluser/.config/sensenova/key" >&2; exit 1; }
MODE="${1:?gen|edit}"; PROMPT="${2:?提示词}"
SIZE="${4:-auto}"; [ "$MODE" = edit ] && { REF="$3"; SIZE="${4:-auto}"; OUT="${5:-/tmp/gen-$(date +%H%M%S).png}"; } || { SIZE="${3:-auto}"; OUT="${4:-/tmp/gen-$(date +%H%M%S).png}"; }
python3 - "$MODE" "$PROMPT" "${REF:-}" "$SIZE" "$OUT" "$KEY" <<'PY'
import sys, json, base64, urllib.request
mode, prompt, ref, size, out, key = sys.argv[1:7]
body = {"model": "sensenova-u1.5-fast", "prompt": prompt, "n": 1,
        "size": size, "output_format": "png", "response_format": "b64_json", "watermark": False}
url = "https://token.sensenova.cn/v1/images/generations"
if mode == "edit":
    b64 = base64.b64encode(open(ref, "rb").read()).decode()
    body["images"] = [{"image_url": f"data:image/png;base64,{b64}"}]
    url = "https://token.sensenova.cn/v1/images/edits"
req = urllib.request.Request(url, data=json.dumps(body).encode(),
    headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
try:
    r = json.load(urllib.request.urlopen(req, timeout=120))
except urllib.error.HTTPError as e:
    print(f"HTTP {e.code}: {e.read().decode()[:400]}", file=sys.stderr); sys.exit(1)
d = r["data"][0]
if "b64_json" in d:
    open(out, "wb").write(base64.b64decode(d["b64_json"]))
else:
    urllib.request.urlretrieve(d["url"], out)
u = r.get("usage", {})
print(f"{out}  size={r.get('size')} tokens={u.get('total_tokens')}")
PY
