#!/usr/bin/env bash
# pre-push — 双闸合一（业主令 2026-10-27：绿了才推）：
#
# A. 推形闸：远端名 origin / master 只许 /opt/o 部署树 / 禁删禁force禁映射。
# B. 绿戳闸：每个被推 head(local_sha) 须持 scripts/check_all.sh 鲜戳
#    .git/check-green-<SHA>（6h 窗）——全链独立跑不在钩内（钩内跑全谱=
#    持 git 连接数分钟，GitHub 掐空闲连接实证 10-27；拆戳=闸仍强制连接短促）。
#
# 伪戳=违例入案（服务端 required-check build-test 兜真伪——假绿推 master
# 照拒）。--no-verify=违例本身。
set -uo pipefail

remote="$1"
case "$remote" in
    origin) ;;
    *) echo "FAIL: 推送远端必须是 origin（O 仓唯一钦定远端），收到: ${remote:-<空>}" >&2; exit 1 ;;
esac

GITDIR=$(git rev-parse --git-dir)
repo_root=$(git rev-parse --show-toplevel)

fail() { echo "❌ [pre-push] $1" >&2; exit 1; }

stamp_ok() {
    # $1=被推 sha，$2=ref 名（报文用）
    [ "$1" = "0000000000000000000000000000000000000000" ] && return 0  # 删 ref 无 head
    local stamp="$GITDIR/check-green-$1"
    [ -f "$stamp" ] || fail "$2 无绿戳——先跑 scripts/check_all.sh 绿了再推（伪戳=违例入案）"
    local age=$(( $(date +%s) - $(date -r "$stamp" +%s) ))
    [ "$age" -le 21600 ] || fail "$2 绿戳已陈（${age}s>6h）——check_all.sh 重跑盖新戳"
    return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$remote_ref" ] || continue
    stamp_ok "$local_sha" "$remote_ref"
    [ "$remote_ref" = "refs/heads/master" ] || continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] \
        && fail "禁删 master"
    case "$local_ref" in
        +*|*:*|refs/tags/*) fail "master 禁 force/refspec/tag/映射形" ;;
    esac
    [ "$repo_root" = "/opt/o" ] || fail "master 只许从部署树 /opt/o 推（当前: $repo_root）"
done

# C. 票号远端对账闸（T-0219——T-0217 撞实证：本地 index 视野陈时 --staged
# 闸盲）。推送本要联网，脚本内 fetch 败降级 WARN 不拦——离线推送不受阻。
if [ -x scripts/check_ticket_numbers.sh ]; then
    scripts/check_ticket_numbers.sh --remote || fail "票号远端对账红——见上（重取 scripts/next_ticket.sh）"
fi

echo "✓ [pre-push] 形闸+绿戳+票号对账全过——推送放行"
exit 0
