#!/usr/bin/env bash
# commit-msg 门禁——坑条目自问（D-585）
# 触发：commit message 含修复类信号 且 暂存面未触碰经验库/待归纳 → warn 提醒（exit 0 不拦）。
MSG_FILE="$1"
MSG=$(cat "$MSG_FILE" 2>/dev/null || true)

printf '%s' "$MSG" | grep -qiE 'fix|修复|修|bug|bugfix|hotfix|regression|回归|病灶|坑|patch|revert' || exit 0

if git -c core.quotepath=off diff --cached --name-only | grep -qE '^docs/工程经验库/|^docs/经济经验库/|待归纳'; then
  exit 0
fi

echo "WARN(D-585): 疑似修复类提交但未触碰 docs/工程经验库|经济经验库/或待归纳——" >&2
echo "  坑成立→条目同 commit 入库；坑不成立→复审收口注记块『坑处置:无坑』显式声明。" >&2
echo "  （本条是提醒非拦截——验收收口时核验坑处置字段）" >&2
exit 0
