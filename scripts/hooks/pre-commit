#!/usr/bin/env bash
# pre-commit gate — 工程纪律 §4.1 十二道（自 nox scripts/hooks/pre-commit 誊入改 O 件名）
# 用法：git config core.hooksPath scripts/hooks
# 骨架未落位期语义：依赖 Go 面/索引工具的闸打「条件未备跳过」放行，不谎报已检（D-616）。
set -euo pipefail

# 1. kill_switch
if [ -f .kill_switch ]; then
  echo "FAIL: .kill_switch 存在，禁止提交" >&2
  exit 1
fi

# 2. 部署树写禁（D-651——/opt/o 只 pull/build/deploy，开发走 worktree）
if [ -x scripts/hooks/check-deploy-tree.sh ]; then
  scripts/hooks/check-deploy-tree.sh || exit 1
fi

# 3. env 凭据直读门禁（D-564）
if [ -f scripts/check-env-reads.sh ]; then
  bash scripts/check-env-reads.sh || {
    echo "[pre-commit] env 凭据直读门禁拒绝（见上）" >&2
    exit 1
  }
fi

# 4. staticcheck 基线（D-512）：只拦本 commit 新增告警，存量另案治理。
# GOTOOLCHAIN 钉 go.mod 版本；export data version 错文=工具链漂移 fail-loud。
if [ ! -f go.mod ] || [ ! -d internal ]; then
  echo "[pre-commit] staticcheck: 条件未备跳过（无 Go 面）"
elif command -v staticcheck >/dev/null 2>&1 || [ -x "$HOME/go/bin/staticcheck" ]; then
  SC_BIN=$(command -v staticcheck || echo "$HOME/go/bin/staticcheck")
  SC_BASE=/tmp/.o_staticcheck_baseline.txt
  SC_NOW=$(mktemp)
  GOTOOLCHAIN="$(go version | awk '{print $3}')" "$SC_BIN" ./internal/... > "$SC_NOW" 2>&1 || true
  if grep -q "export data version" "$SC_NOW"; then
    echo "FAIL: staticcheck 工具链不兼容（export data version 错文，本机 go 与 go.mod 漂移）" >&2
    grep "export data version" "$SC_NOW" | head -3 >&2
    rm -f "$SC_NOW"
    exit 1
  fi
  if [ -f "$SC_BASE" ] && grep -q "export data version" "$SC_BASE"; then
    rm -f "$SC_BASE"
  fi
  if [ ! -f "$SC_BASE" ]; then
    cp "$SC_NOW" "$SC_BASE"
  fi
  NEW_WARN=$(comm -23 <(sort "$SC_NOW") <(sort "$SC_BASE") | grep -v "^$" | head -5 || true)
  if [ -n "$NEW_WARN" ]; then
    echo "FAIL: staticcheck 新增告警（存量另案，新增必须自清）：" >&2
    echo "$NEW_WARN" >&2
    rm -f "$SC_NOW"
    exit 1
  fi
  rm -f "$SC_NOW"
else
  echo "[pre-commit] staticcheck: 条件未备跳过（binary 不在 PATH）"
fi

# 5. 文件规模门禁（check-lines 与 CI 同令）
if [ -x scripts/check-lines.sh ]; then
  scripts/check-lines.sh
fi

# 6. 迁移契约门禁（D-496：键域列 COMMENT+CHECK、禁 backup 残留表、迁移号唯一）
if [ -x scripts/check_migration_contract.sh ]; then
  scripts/check_migration_contract.sh
fi
# T-0119 能力账致密化机检（种子面 vs skills 钉表）。
if git -c core.quotepath=off diff --cached --name-only | grep -qE '^skills/|^migrations/0049'; then
  go run ./tools/capcheck || {
    echo "FAIL: capcheck 未过——skills 面钉表 vs 0049 种子行缺席（致密化退回）" >&2
    exit 1
  }
fi
# 6b. 迁移序号三断言（T-0109——canon migration-number-collision 硬闸）。
if [ -x scripts/check_migrations.sh ]; then
  scripts/check_migrations.sh
fi
if [ -x scripts/check_no_forbidden_patterns.sh ]; then
  scripts/check_no_forbidden_patterns.sh
fi

# 7. gofmt 门禁（-c core.quotepath=off 必须带：中文路径 quoted 形态破匹配）
STAGED_GO=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)
if [ -n "$STAGED_GO" ]; then
  UNFMT=$(echo "$STAGED_GO" | xargs gofmt -l)
  if [ -n "$UNFMT" ]; then
    echo "FAIL: gofmt 漂移: $UNFMT —— gofmt -w 后重试" >&2
    exit 1
  fi
fi

# 8. 经验库 schema 门禁（D-130）：staged 触经验库目录→索引 gen --check；索引工具未落位则跳过。
if git -c core.quotepath=off diff --cached --name-only | grep -qE '^docs/工程经验库/|^docs/经济经验库/'; then
  if [ -d tools/kbgen ]; then
    (cd tools/kbgen && go run . gen --check) || {
      echo "FAIL: okb gen --check 未过——条目 frontmatter 须符合 Schema（模板 docs/工程经验库/模板.md），索引自动生成禁手编" >&2
      exit 1
    }
    if git -c core.quotepath=off diff --cached --name-only | grep -qE '^docs/经济经验库/'; then
      (cd tools/kbgen && go run . gen-econ --check) || {
        echo "FAIL: okb gen-econ --check 未过——经济条目须含判据挂接字段，索引自动生成禁手编" >&2
        exit 1
      }
    fi
  else
    echo "[pre-commit] 经验库 schema 闸: 条件未备跳过（tools/kbgen 未落位——索引工具待迁）"
  fi
fi

# 8b. skills 索引机生门禁（T-0052）：staged 触 skills/→kbgen skills --check（与经验库闸同款）。
if git -c core.quotepath=off diff --cached --name-only | grep -qE '^skills/'; then
  if [ -d tools/kbgen ]; then
    (go run ./tools/kbgen skills --check) || {
      echo "FAIL: skills/索引.md 陈旧——staged 改 skills/ 须跑 go run ./tools/kbgen skills 重建（禁手编）" >&2
      exit 1
    }
  else
    echo "[pre-commit] skills 索引闸: 条件未备跳过（tools/kbgen 未落位）"
  fi
fi

# 9. 秘钥扫描门禁（D-460）：staged 新增行匹配秘钥形态即拒。
# PEM 模式写作 PRIVATE+空白+KEY----- 的 ERE（字面量含真实空格会自匹配本 hook 自身改动）。
SECRET_ADDED=$(git -c core.quotepath=off diff --cached -U0 | grep '^+' | grep -v '^+++' | sed 's/^+//' || true)
if [ -n "$SECRET_ADDED" ]; then
  check_secret() {
    if printf '%s\n' "$SECRET_ADDED" | grep -iqE "$1"; then
      echo "FAIL: staged 新增行疑似秘钥泄漏（$2）——占位化/移出后重试；误报找复审席裁定，禁 --no-verify" >&2
      printf '%s\n' "$SECRET_ADDED" | grep -inE "$1" | head -3 >&2 || true
      exit 1
    fi
  }
  _secret_sep='["'"'"'=:[:space:]]+'
  check_secret "mrpc_(live|trial)_[a-f0-9]{16,}" "MRPC 账号 token"
  check_secret "api[_-]?key${_secret_sep}[A-Za-z0-9]{20,}" "API key 赋值"
  check_secret "secret${_secret_sep}[A-Za-z0-9]{20,}" "secret 赋值"
  check_secret "PRIVATE[[:space:]]+KEY-----" "PEM 私钥块"
  check_secret "(^|[^A-Za-z0-9])(ghp_|gho_)[A-Za-z0-9]{20,}" "GitHub token 前缀"
  check_secret "(^|[^A-Za-z0-9])sk-[A-Za-z0-9]{20,}" "sk- 秘钥前缀"
  check_secret "O_AUTH_TOKEN=[A-Za-z0-9]{16,}" "O_AUTH_TOKEN 非占位值"
fi

# 10. 资金/审计写通道 `_ =` 门禁（D-508）：热路径清单内新增 `_ = <err调用>` 即拒；
# 确属无返回值丢弃须行内 `// audit-noreturn-ok <理由>` 豁免。
# 清单=六域钱径落位后按实际包路增补（D-212 部门目录沿用）。
AUDIT_HOT_FILES='internal/trading/exec/pipeline_legs_persist.go
internal/trading/exec/cex_executor.go
internal/trading/exec/cex_executor_confirm.go
internal/trading/exec/cex_executor_margin_gate.go
internal/trading/autotrade/engine_swaparb.go
internal/trading/autotrade/gate.go
internal/trading/autotrade/gate_helpers.go
internal/store/pgstore/execution_controls.go'
BAD_DISCARD=""
for f in $AUDIT_HOT_FILES; do
  [ -f "$f" ] || continue
  hits=$(git -c core.quotepath=off diff --cached -U0 -- "$f" 2>/dev/null | grep '^+' | grep -v '^+++' | grep -E '_ = ' | grep -v 'audit-noreturn-ok' || true)
  [ -n "$hits" ] && BAD_DISCARD="${BAD_DISCARD}${f}:\n${hits}\n"
done
if [ -n "$BAD_DISCARD" ]; then
  echo "FAIL: 资金/审计热路径新增 \`_ =\` 吞错（D-508 写路径审计契约）——错误须上抛(fail-stop)或 fail-open+声张(log+warn)；确属无返回值丢弃须行内 \`// audit-noreturn-ok <理由>\` 豁免：" >&2
  printf '%b' "$BAD_DISCARD" >&2
  exit 1
fi

# 11. import 方向门禁（D-514）：internal/* 跨包 import 白名单冻结。
if git diff --cached --name-only | grep -qE '\.go$'; then
  if [ -f go.mod ] && [ -d internal ]; then
    if ! ./scripts/check_import_direction.sh >/dev/null 2>&1; then
      echo "FAIL: import 方向门禁违例——详见 ./scripts/check_import_direction.sh 直接跑出的违例行" >&2
      ./scripts/check_import_direction.sh 2>&1 | tail -15 >&2 || true
      exit 1
    fi
  else
    echo "[pre-commit] import 方向闸: 条件未备跳过（无 Go 面）"
  fi
fi

# 11b. 大文件/二进制闸（T-0091）：staged 文件 >1MB 且后缀不在源码白名单，或
# file 判定为 ELF/Mach-O/PE 可执行体（白名单后缀豁免）即拒——go build cwd
# 产物被 git add -A 扫入两犯在档（fillsprobe 16MB/core 28MB）。
SRC_EXT_RE='\.(go|ts|tsx|js|json|md|sql|proto|html|css|yaml|yml|toml|svg|png|txt)$'
BIGFILE_BAD=""
while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(stat -c %s "$f" 2>/dev/null || echo 0)
  if printf '%s' "$f" | grep -qiE "$SRC_EXT_RE"; then
    continue # 白名单后缀豁免两道判定
  fi
  ftype=$(file -b "$f" 2>/dev/null || echo "?")
  case "$ftype" in
    ELF*|*Mach-O*|PE32*|*PE32+*)
      BIGFILE_BAD="${BIGFILE_BAD}  $f  （可执行体: $ftype）\n" ;;
    *)
      if [ "$size" -gt 1048576 ]; then
        BIGFILE_BAD="${BIGFILE_BAD}  $f  $((size/1024))KB（非源码后缀大文件: $ftype）\n"
      fi ;;
  esac
done < <(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)
if [ -n "$BIGFILE_BAD" ]; then
  echo "FAIL: staged 大文件/二进制疑似构建产物——go build 产物请 \`-o /tmp\` 输出或加 .gitignore，勿提交入仓：" >&2
  printf '%b' "$BIGFILE_BAD" >&2
  exit 1
fi

# 12. 未推送 warn（D-588）：本地领先远端 N commit 即 warn 断链风险，推送成功自消。
UPSTREAM=""
if git rev-parse --abbrev-ref @{u} >/dev/null 2>&1; then
  UPSTREAM="@{u}"
elif git rev-parse --verify origin/master >/dev/null 2>&1; then
  UPSTREAM="origin/master"
fi
if [ -n "$UPSTREAM" ]; then
  AHEAD=$(git rev-list --count "$UPSTREAM..HEAD" 2>/dev/null || echo 0)
  if [ "$AHEAD" -gt 0 ]; then
    echo "WARN(D-588): 本地领先 $UPSTREAM $AHEAD 个 commit 未推送——" >&2
    echo "  推送失败滞留本地是断链风险（部署/复审看远端）。用 scripts/git_push.sh 带重试推送。" >&2
  fi
fi

# 尾行提醒（不拦）
echo "OK: pre-commit gate passed. Remember: diff 通读无死代码/TODO/调试残留."
