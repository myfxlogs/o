# PHASE core 镜像（自 nox Dockerfile.core 誊入；钉版规=架构约束 §1.1）。
# 前置依赖：web/、proto/、cmd/core、go.mod（T-0006 骨架票落位后方可构建）。
FROM node:24-alpine AS web-build
WORKDIR /src
COPY web/package.json web/package-lock.json web/
RUN cd web && npm ci
# web/src/gen gitignore——镜像内须 buf regen（buf 钉 1.74.0，与 CI/本地三处同号）
RUN npm i -g @bufbuild/buf@1.74.0
COPY buf.yaml buf.gen.web.yaml ./
COPY proto/dashboardv1 proto/dashboardv1
COPY web/ web/
RUN buf generate --template buf.gen.web.yaml
RUN cd web && npm run build
# P4 前端本体未落位——build 脚本只 echo 不产 dist，下游 COPY --from 会炸（T-0009）。
# 真前端落位后 dist/index.html 已存在，此步零触碰；目录有文件即满足 go:embed web/dist 语义。
RUN cd web && mkdir -p dist && if [ ! -s dist/index.html ]; then \
      printf '<!doctype html><meta charset="utf-8"><title>PHASE</title><p>占位——前端本体=P4</p>\n' > dist/index.html; \
    fi

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY . .
# internal/gen 亦 gitignore 不随 COPY 入镜像——Go 侧同样镜像内 regen（T-0009，与 CI go build 前
# buf generate 同序）。buf 由源码 go install（npm 全局 buf 是 node 壳，golang 面无 node——
# 跨阶段挪用不可行）；钉 1.74.0 与 CI/本地三处同号。Go 插件钉版与 CI（ci.yml）/go.mod 同号；
# buf.gen.core.yaml 只含 Go 插件段。
COPY --from=web-build /src/web/dist web/dist
RUN go install github.com/bufbuild/buf/cmd/buf@v1.74.0 && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 && \
    go install connectrpc.com/connect/v2/cmd/protoc-gen-connect-go@v2.0.1
RUN buf generate --template buf.gen.core.yaml
RUN go build -o /bin/core ./cmd/core

FROM alpine:3.20
COPY --from=build /bin/core /bin/core
ENTRYPOINT ["/bin/core"]
