# o-oci-bus-tunnel.service —— dev→OCI 反向隧道 ssh -L 15436（restrict+
# permitopen 专钥 o_oci_bus——o-sg-tunnel 同形无壳钥）。
[Unit]
Description=o-oci-bus-tunnel (localhost:15436→OCI eventbus)
After=network-online.target

[Service]
ExecStart=/opt/o/scripts/oci_bus_tunnel_up.sh
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
