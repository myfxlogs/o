# o-projector env 模板（部署时填实值——T-0168）。
# MD_PG_DSN=本机 PG-md（5435，T-0167 docker-compose.dev.yml）；
# SG_PG_DSN=隧道径 SG PG（15433，o-sg-tunnel 转发——projector_rw 投影写权角色）。
MD_PG_DSN=postgres://o:PASSWORD@127.0.0.1:5435/o?sslmode=disable
SG_PG_DSN=postgres://projector_rw:PASSWORD@127.0.0.1:15433/o?sslmode=disable
