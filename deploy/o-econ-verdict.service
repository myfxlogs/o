# o-econ-verdict.service —— 经济案裁定席 headless 单发批件（T-0312 第三刀
# 同构 o-regime-analyst 逐字对形；cwd=/var/tmp/o-verdict scratch 零仓件）。
[Unit]
Description=o-econ-verdict (经济案裁定席 headless 批件)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/tmp/o-verdict
ExecStartPre=/usr/bin/env mkdir -p /var/tmp/o-verdict
ExecStart=/opt/o/scripts/meta/verdict_tick.sh
NoNewPrivileges=true
